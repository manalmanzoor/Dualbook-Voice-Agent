# ===========================================================================
#  DualBook — environment configuration
#
#  1.  cp .env.example .env          (Windows:  copy .env.example .env)
#  2.  Fill in STEP 1 only — that's enough to run everything except real
#      phone calls and real WhatsApp delivery.
#  3.  python demo_data.py && python run_dashboard.py
#
#  Never commit .env — it's already in .gitignore.
#  Anything marked "leave as is" already has a working default.
#  Full walkthrough with screenshots-level detail: SETUP.md
# ===========================================================================


# ===========================================================================
#  STEP 1 — REQUIRED (free, ~60 seconds)
# ===========================================================================
#  This one key powers the conversation for BOTH agents and both simulators.
#
#  Get it:  https://console.groq.com/keys
#           sign in -> "Create API Key" -> copy. No credit card.
#
#  Starts with  gsk_...
# ---------------------------------------------------------------------------

GROQ_API_KEY=

LLM_PROVIDER=groq


#  --- Alternatives to Groq — YOU DO NOT NEED THESE -------------------------
#
#  These are REPLACEMENTS for Groq, not extras. You fill in exactly ONE brain
#  key, and Groq above is already it. Leave everything in this block commented
#  out unless you specifically want to swap providers.
#
#  To switch: uncomment ONE line below, put your key on it, and change
#  LLM_PROVIDER above to match. Nothing else in the project changes.
#
#    LLM_PROVIDER=gemini      free   https://aistudio.google.com/apikey
#    LLM_PROVIDER=openrouter  free   https://openrouter.ai/keys  (":free" models)
#    LLM_PROVIDER=ollama      free   https://ollama.com -> ollama pull llama3.1
#                                    (runs locally — needs no key at all)
#    LLM_PROVIDER=openai      paid   https://platform.openai.com/api-keys
#    LLM_PROVIDER=anthropic   paid   https://platform.claude.com
#                                    (also: pip install anthropic)

# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_API_KEY=      # only if you put local Ollama behind an auth proxy


# ===========================================================================
#  ✅ YOU CAN STOP HERE.
#
#  With just GROQ_API_KEY set, all of this works right now:
#
#    python demo_data.py                            seed demo data
#    python run_dashboard.py                        dashboard on :8080
#    python run_whatsapp.py simulate +923001234567   full WhatsApp agent
#    python run_voice.py    simulate +923001234567   full voice agent
#    python view_bookings.py --csv                  bookings + CSV export
#
#  The simulators run the SAME booking + memory logic as the live channels —
#  only the audio/transport is missing. Continue below only when you want
#  real WhatsApp messages or real phone calls.
# ===========================================================================


# ===========================================================================
#  STEP 2 — OPTIONAL: real WhatsApp messages
#  Needed only for:  python run_whatsapp.py serve
# ===========================================================================
#  meta  = Meta WhatsApp Cloud API   <-- FREE. Recommended. The default.
#  whapi = Whapi.Cloud               <-- paid
# ---------------------------------------------------------------------------

WHATSAPP_PROVIDER=meta

#  --- Meta WhatsApp Cloud API (free) ---------------------------------------
#  Free tier: test number that can message up to 5 verified recipients,
#  plus 1,000 free service conversations/month.
#
#  Where to find these:
#    https://developers.facebook.com/apps
#      -> Create app -> "Business"
#      -> Add product -> WhatsApp -> Set up
#      -> you land on the "API Setup" page. Everything below is on it.
#
#  META_WA_TOKEN           "Temporary access token" at the top.  Starts EAAG...
#                          ⚠ Expires in 24h. For permanent: Business Settings
#                            -> System Users -> Add -> Generate token with
#                            whatsapp_business_messaging + _management
#  META_WA_PHONE_NUMBER_ID "Phone number ID" under the "From" dropdown.
#                          (NOT the phone number itself — the numeric ID.)
#  META_WA_VERIFY_TOKEN    You invent this. Any random string. You'll paste
#                          the SAME string into Meta's webhook config.
#
#  Then:  python run_whatsapp.py serve --port 8000
#         ngrok http 8000
#         Meta -> WhatsApp -> Configuration -> Webhook -> Edit
#           Callback URL:  https://<your-id>.ngrok.io/webhook
#           Verify token:  the string you chose below
#           Save, then "Manage" -> subscribe to  messages

META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=

#  --- Whapi.Cloud — ALTERNATIVE to Meta, not an addition -------------------
#  Ignore this unless you're paying for Whapi instead of using Meta's free
#  tier. To use it: uncomment both lines and set WHATSAPP_PROVIDER=whapi above.
#
#  Token: https://panel.whapi.cloud -> your channel -> API token
#  WHAPI_WEBHOOK_SECRET: you invent it; add it as an `X-Webhook-Secret` header
#  on the Whapi webhook so nobody else can POST fake bookings at your endpoint.

# WHAPI_TOKEN=
# WHAPI_WEBHOOK_SECRET=


# ===========================================================================
#  STEP 3 — OPTIONAL: real phone calls
#  Pick ONE provider. Neither is free.
# ===========================================================================

#  --- Option A: Vapi -------------------------------------------------------
#  COST: $0.05/min voice, $0.005/msg chat. Model/STT/TTS billed at cost, and
#  $0 if you bring your own key — which is why VAPI_LLM_PROVIDER is groq.
#
#  ⚠ Vapi has NO WhatsApp channel. Its channels are voice, web chat and SMS
#    (US only). Use STEP 2 for WhatsApp. Details in SETUP.md.
#
#  Where to find these:
#    https://dashboard.vapi.ai -> Organization -> API Keys
#      VAPI_API_KEY     = the PRIVATE key. Server-side only, never ship it.
#      VAPI_PUBLIC_KEY  = the PUBLIC key. The only one safe in a browser.
#    https://dashboard.vapi.ai -> Phone Numbers
#      VAPI_PHONE_NUMBER_ID = the id of a number you bought/imported.
#
#  ⚠ VAPI_SERVER_URL is the step people miss. Vapi executes save_booking by
#    POSTing to YOUR server. Without it, calls sound perfect and NOTHING IS
#    EVER SAVED.
#      python run_vapi.py serve --port 8002
#      ngrok http 8002
#      VAPI_SERVER_URL=https://<your-id>.ngrok.io/vapi/webhook
#      python run_vapi.py provision      <- prints VAPI_ASSISTANT_ID
#
#  VAPI_SERVER_SECRET: you invent it. Vapi echoes it back as x-vapi-secret so
#  the webhook can reject forged bookings.
#
#  Check your work any time:  python run_vapi.py doctor

VAPI_API_KEY=
VAPI_PUBLIC_KEY=
VAPI_SERVER_URL=
VAPI_SERVER_SECRET=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

#  --- Option B: Uplift AI — ALTERNATIVE to Vapi, not an addition -----------
#  Pick one voice provider or the other. Uncomment these only if you're using
#  Uplift instead of Vapi.
#
#  Key: https://upliftai.org -> dashboard -> API keys
#  UPLIFT_ASSISTANT_ID is optional: sessions are created adhoc so each caller's
#  memory can be injected. It's only used by the --persisted path.

# UPLIFT_API_KEY=
# UPLIFT_ASSISTANT_ID=


# ===========================================================================
#  DEFAULTS — leave as is unless you have a reason
# ===========================================================================

#  Business name used in prompts and greetings
BUSINESS_NAME=SparkleWash Car Care

#  Storage. Blank = dualbook/data/dualbook.db and dualbook/data/bookings.csv
DB_PATH=
CSV_EXPORT_PATH=

#  LLM tuning. Blank LLM_MODEL = the provider's default model.
#  LLM_BASE_URL is only for self-hosted / proxied OpenAI-compatible endpoints.
LLM_MODEL=
LLM_BASE_URL=

#  Vapi voice stack
VAPI_API_URL=https://api.vapi.ai
VAPI_LLM_PROVIDER=groq
VAPI_LLM_MODEL=llama-3.3-70b-versatile
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-2
VAPI_TRANSCRIBER_LANGUAGE=en

#  Meta / Whapi endpoints
META_WA_API_URL=https://graph.facebook.com/v21.0
WHAPI_API_URL=https://gate.whapi.cloud

#  Uplift voice stack
UPLIFT_API_URL=https://api.upliftai.org
UPLIFT_LLM_PROVIDER=groq
UPLIFT_LLM_MODEL=llama-3.3-70b-versatile
UPLIFT_STT_PROVIDER=deepgram
UPLIFT_STT_MODEL=nova-2
UPLIFT_STT_LANGUAGE=en
UPLIFT_TTS_PROVIDER=upliftai
UPLIFT_TTS_VOICE_ID=v_meklc281
UPLIFT_TTS_OUTPUT_FORMAT=MP3_22050_32
